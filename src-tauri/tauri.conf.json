{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open HUB",
  "version": "0.3.5",
  "identifier": "dev.local.openghub.mchose",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Open HUB",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "visible": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu",
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Open HUB Community",
    "copyright": "Copyright 2026 Abidur Rahman. Not affiliated with Logitech.",
    "category": "Utility",
    "homepage": "https://github.com/ZZXYWQ/Open-HUB",
    "shortDescription": "多品牌鼠标与灯光控制中心",
    "longDescription": "Open HUB：按品牌隔离的鼠标设置、配置导入、灯光效果及电脑 RGB 同步。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "../installer/mchose-hooks.nsh",
        "template": "../installer/mchose-installer.nsi",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "license": "GPL-3.0-or-later",
    "licenseFile": "../installer/license-and-privacy.txt",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/rgb-engine/": "rgb-engine/",
      "resources/notices/": "notices/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERDkzQzk3RTM4Nzc2MEUKUldRT2RvZmpsenpaYldEWHk2ZnkwbEJ6NGdLRmlKd0w1S09GajBMeVRoeVBZdC9kc3JFR0RDVDkK",
      "endpoints": [
        "https://raw.githubusercontent.com/ZZXYWQ/Open-HUB/main/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
