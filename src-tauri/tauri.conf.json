{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open GHub",
  "version": "0.1.2",
  "identifier": "dev.local.openghub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Open GHub",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "visible": true,
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Abidur Rahman",
    "copyright": "Copyright 2026 Abidur Rahman. Not affiliated with Logitech.",
    "category": "Utility",
    "homepage": "https://github.com/abidr/open-ghub",
    "shortDescription": "Lightweight configurator for Logitech HID++ mice",
    "longDescription": "Open GHub configures Logitech gaming mice over HID++: DPI, report rate, per-game profiles with auto-switching, and battery alerts from the system tray. Independent project, not affiliated with Logitech.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "license": "GPL-3.0-or-later",
    "licenseFile": "../installer/license-and-privacy.txt",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4QTA4RTZCMzUyQjgzQTYKUldTbWd5czFhNDZnNk05QmRnYUZVWjU1VVFYbWNwSWZDSnE5dlNvNGErYTVENFJHWEtPc3c2M1YK",
      "endpoints": [
        "https://github.com/abidr/open-ghub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
